+
+        if (manualOverlay) {
+            function drawManualLevel(value, color, label, dashed) {
+                if (value == null || !isFinite(value)) return;
+                var y = priceY(value);
+                if (y < margin.top - 2 || y > margin.top + geometry.mainHeight + 2) return;
+                ctx.save();
+                ctx.strokeStyle = color;
+                ctx.lineWidth = 1.2;
+                if (dashed) ctx.setLineDash([5, 3]);
+                ctx.beginPath(); ctx.moveTo(margin.left, y); ctx.lineTo(margin.left + geometry.plotWidth, y); ctx.stroke();
+                ctx.setLineDash([]);
+                ctx.font = 'bold 7px sans-serif';
+                ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
+                var text = label + '  ' + formatPrice(value);
+                var width = Math.max(52, Math.min(118, text.length * 4.8 + 10));
+                ctx.fillStyle = 'rgba(7,17,31,.88)';
+                ctx.fillRect(margin.left + 3, y - 7, width, 14);
+                ctx.fillStyle = color;
+                ctx.fillText(text, margin.left + width - 2, y);
+                ctx.restore();
+            }
+            (manualOverlay.positions || []).forEach(function (position) {
+                var sideColor = position.side === 'buy' ? palette.up : palette.down;
