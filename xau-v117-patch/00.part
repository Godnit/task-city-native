diff -ruN '--exclude=vendor-data.min.js' old116/app/build.gradle src/app/build.gradle
--- old116/app/build.gradle	2026-08-30 20:32:27.000000000 +0000
+++ src/app/build.gradle	2026-08-31 08:05:22.827476422 +0000
@@ -10,8 +10,8 @@
         applicationId 'com.maimon.xaulab'
         minSdk 26
         targetSdk 35
-        versionCode 17
-        versionName '1.16.0'
+        versionCode 18
+        versionName '1.17.0'
     }
 
     buildTypes {
diff -ruN '--exclude=vendor-data.min.js' old116/app/src/main/assets/app.css src/app/src/main/assets/app.css
--- old116/app/src/main/assets/app.css	2026-08-30 20:35:15.000000000 +0000
+++ src/app/src/main/assets/app.css	2026-08-31 08:05:22.827384284 +0000
@@ -1293,3 +1293,24 @@
 body.light .meta-account-identity span { color:#637990; }
 body.light .tester-account-fields input:disabled, body.light .tester-account-fields select:disabled { color:#17314d; -webkit-text-fill-color:#17314d; background:#f3f6f9; }
 @media (max-width:350px) { .account-gate-grid { grid-template-columns:1fr; } .account-gate-card { padding:18px 14px 14px; } }
+
+
+/* v1.17 manual trading + Meta-style terminal */
+.new-order-button { border:0; border-radius:9px; padding:8px 12px; background:#1b8f66; color:#fff; font-weight:850; font-size:11px; box-shadow:0 4px 14px rgba(27,143,102,.20); }
+.new-order-button:active { transform:translateY(1px); }
+body.light .new-order-button { background:#078960; }
+.meta-position-actions { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:8px; direction:ltr; }
+.meta-position-actions small { color:#7f93a8; font-size:9px; }
+.meta-position-actions button { border:1px solid #39516b; border-radius:7px; padding:5px 10px; color:#dfe8f1; background:#102237; font-size:9px; font-weight:800; }
+.pending-order-row { opacity:.94; }
+.pending-title { border-top:1px solid #26384e; }
+.pending-list { padding-bottom:14px; }
+body.light .meta-position-actions button { color:#34495e; border-color:#cfd8e2; background:#f5f8fb; }
+body.light .pending-title { border-color:#e0e3e8; }
+.manual-order-sheet { max-height:86vh; }
+.manual-quote-line { margin:10px 0 13px; padding:11px 12px; border-radius:10px; border:1px solid #2c4158; background:#0a1726; color:#dce8f3; text-align:center; font-size:12px; font-weight:850; letter-spacing:.2px; }
+.manual-order-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
+.manual-order-note { margin:5px 0 13px; color:var(--muted); font-size:9px; line-height:1.7; }
+#placeManualOrder.sell-action { background:#d94d63; border-color:#d94d63; }
+body.light .manual-quote-line { background:#f4f7fa; border-color:#d5dee7; color:#263b51; }
+@media (max-width:360px) { .manual-order-grid { grid-template-columns:1fr; } }
