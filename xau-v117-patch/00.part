+                drawManualLevel(position.stop, palette.down, 'SL #' + position.ticket, true);
+                drawManualLevel(position.target, palette.up, 'TP #' + position.ticket, true);
+            });
+            (manualOverlay.pending || []).forEach(function (order) {
