t) throw new Error('Take Profit must stay above the current price');\\n                    } else {\\n                        if (draft.stop != null && draft.stop <= market) throw new Error('Stop Loss must stay above the current price');\\n                        if (draft.target != null && draft.target >= market) throw new Error('Take Profit must stay below the current price');\\n                    }\\n                }\\n            } catch (error) { showToast(error.message, 'error'); return false; }\\n            position.stop = draft.stop; position.target = draft.target;\\n        } else {\\n            var order = manualPendingByTicket(draft.ticket);\\n            if (!order) { cancelManualDraft(false); return false; }\\n            order.price = draft.price;\\n        }\\n        state.manualDraft = null;\\n        persistAccountNow();\\n        recalculateManualAccount(currentManualQuote());\\"