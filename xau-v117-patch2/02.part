+    function closeManualPosition(ticket, reason, quote, forcedExit) {
+        if (!state.account) return false;
+        var positions = state.account.manualPositions || [];
+        var index = positions.findIndex(function (position) { return Number(position.ticket) === Number(ticket); });
+        if (index < 0) return false;
+        quote = quote || currentManualQuote();
+        if (!quote) return false;
+        var position = positions[index];
+        var exitPrice = forcedExit != null ? number(forcedExit, null) : (position.side === 'buy' ? quote.bid : quote.ask);
+        if (exitPrice == null) return false;
+        var profit = (position.side === 'buy' ? exitPrice - position.entry : position.entry - exitPrice) * position.lot * 100;
+        state.account.balance += profit;
+        var trade = {
+            source: 'manual', ticket: position.ticket, side: position.side, lot: position.lot,
+            entry: position.entry, exit: exitPrice, entryTime: position.entryTime, exitTime: quote.t,
+            reason: reason || 'إغلاق يدوي', profit: profit, balance: state.account.balance,
+            stop: position.stop, target: position.target, margin: position.margin,
+            entryIndex: position.entryIndex == null ? Infinity : position.entryIndex,
+            exitIndex: quote.index == null ? Infinity : quote.index
+        };
+        state.account.trades = (state.account.trades || []).concat([trade]).slice(-1200);
+        positions.splice(index, 1);
+        recalculateManualAccount(quote);
+        persistAccountNow();
+        refreshManualOverlay(false);
+        renderRobotTerminal();
+        return true;
+    }
+
+    function openManualPosition(side, lot, entry, stop, target, quote, ticket, sourceLabel) {
+        if (!state.account || !quote) return false;
+        lot = clamp(number(lot, .1), .01, 100);
+        var margin = requiredManualMargin(entry, lot);
+        recalculateManualAccount(quote);
+        if (margin > Math.max(0, state.account.freeMargin)) {
+            showToast('الهامش المتاح لا يكفي لفتح هذه الصفقة', 'error');
+            return false;
+        }
+        var position = {
+            source: 'manual', ticket: ticket || state.account.nextTicket++, side: side, lot: lot,
+            entry: entry, stop: stop, target: target, margin: margin,
+            entryTime: quote.t, entryIndex: quote.index == null ? Infinity : quote.index,
+            sourceLabel: sourceLabel || 'يدوي'
+        };
+        state.account.manualPositions = (state.account.manualPositions || []).concat([position]).slice(-50);
+        state.account.lastLot = lot;
+        recalculateManualAccount(quote);
+        persistAccountNow();
+        refreshManualOverlay(false);
+        return true;
+    }
+
+    function processManualTrading(quote, replayCandle) {
+        if (!state.account || !quote) return;
+        var changed = false;
+        var pending = state.account.pendingOrders || [];
+        var spread = quote.spread == null ? Math.max(0, quote.ask - quote.bid) : quote.spread;
+        var bidLow = replayCandle ? replayCandle.l : quote.bid;
+        var bidHigh = replayCandle ? replayCandle.h : quote.bid;
+        var askLow = replayCandle ? replayCandle.l + spread : quote.ask;
+        var askHigh = replayCandle ? replayCandle.h + spread : quote.ask;
+        var triggered = [];
+        pending.forEach(function (order) {
+            var hit = order.type === 'buyLimit' ? askLow <= order.price
+                : order.type === 'sellLimit' ? bidHigh >= order.price
+                : order.type === 'buyStop' ? askHigh >= order.price
+                : order.type === 'sellStop' ? bidLow <= order.price : false;
+            if (hit) triggered.push(order);
+        });
+        triggered.forEach(function (order) {
+            var triggerQuote = Object.assign({}, quote);
+            var opened = openManualPosition(order.side, order.lot, order.price, order.stop, order.target, triggerQuote, order.ticket, order.typeLabel);
+            if (opened) {
+                state.account.pendingOrders = (state.account.pendingOrders || []).filter(function (item) { return item.ticket !== order.ticket; });
+                changed = true;
+            }
+        });
+
+        var positions = (state.account.manualPositions || []).slice();
+        positions.forEach(function (position) {
+            var stopHit = false, targetHit = false;
+            if (position.side === 'buy') {
+                stopHit = position.stop != null && bidLow <= position.stop;
+                targetHit = position.target != null && bidHigh >= position.target;
+            } else {
+                stopHit = position.stop != null && askHigh >= position.stop;
+                targetHit = position.target != null && askLow <= position.target;
+            }
+            if (stopHit) { closeManualPosition(position.ticket, 'وقف الخسارة', quote, position.stop); changed = true; }
+            else if (targetHit) { closeManualPosition(position.ticket, 'هدف الربح', quote, position.target); changed = true; }
+        });
+        recalculateManualAccount(quote);
